Algoritmo Hallar_Area_Triangulo
	// Yeyson Leiva
	// Definir Variables
	definir base, altura como entero
	Definir area como real
	// Entrada de Datos
	Escribir "Ingrese base del Triangulo: "
	Leer base
	Escribir "Ingrese la altura del triangulo: "
	Leer altura
	// Proceso
	area <- (base * altura) / 2
	// Salida Datos
	Escribir "El area del triangulo es ",area," m2"
FinAlgoritmo
