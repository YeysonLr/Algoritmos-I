Algoritmo Metros_A_Pulgadas
	Escribir 'Fecha: ', FechaActual();
	Escribir 'Hora: ', HoraActual();
	Escribir 'Yeyson Yamir Leiva Romero';
	// Definir variables
	Definir metros, pulgadas Como Real;
	// Entrada de datos
	Escribir 'Ingrese la cantidad en metros: ';
	Leer metros;
	// Proceso
	pulgadas <- metros*39.37;
	// Salida de datos
	Escribir 'El equivalente en pulgadas es: ', pulgadas;
FinAlgoritmo
