"""
Simulación de menú de cajero de banco
"""

import random
from datetime import datetime

# Fecha y hora
print("Fecha:", datetime.now().date())
print("Hora:", datetime.now().time())

# Nombre
print("Yeyson Yamir Leiva Romero")

# Menú
print("\n----- MENU CAJERO -----")
print("<1> Depositar")
print("<2> Retirar")
print("<3> Consultar")
print("<4> Salir")

opcion = int(input("Seleccione una opción: "))

# Proceso según opción
if opcion == 1:
    monto = float(input("Ingrese monto a depositar: "))
    if monto > 0:
        print("Depósito realizado correctamente")
    else:
        print("Monto inválido")

elif opcion == 2:
    monto = float(input("Ingrese monto a retirar: "))
    if monto > 0:
        print("Retiro realizado correctamente")
    else:
        print("Monto inválido")

elif opcion == 3:
    print("Consulta se imprimió en Recibo impreso")

elif opcion == 4:
    print("Se finalizaron las operaciones")

else:
    print("Opción inválida")